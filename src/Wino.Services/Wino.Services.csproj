<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Platforms>x86;x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="Misc\**" />
	  <EmbeddedResource Remove="Misc\**" />
	  <None Remove="Misc\**" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="HtmlAgilityPack" />
		<PackageReference Include="Ical.Net" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Sentry.Serilog" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.Sinks.Debug" />
		<PackageReference Include="Serilog.Sinks.File" />
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" />
		<PackageReference Include="Wino.Mail.Contracts" />
		<PackageReference Include="Wino.Mail.AI.Abstractions" Condition="'$(WinoLightweightHost)' != 'true'" />
		<PackageReference Include="Wino.Mail.AI.ContentProcessing" Condition="'$(WinoLightweightHost)' != 'true'" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Wino.Core.Domain\Wino.Core.Domain.csproj" />
		<ProjectReference Include="..\Wino.Core.ML\Wino.Core.ML.csproj" />
		<ProjectReference Include="..\Wino.Messages\Wino.Messaging.csproj" />
	</ItemGroup>
	<ItemGroup>
		<TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
		<EmbeddedResource Include="Security\Keys\intelligence-public.pem" />
		<EmbeddedResource Include="Configuration\known-imap-providers.json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Wino.SourceGenerators\Wino.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;TrimMode;SelfContained" />
	</ItemGroup>

	<ItemGroup Condition="'$(WinoLightweightHost)' == 'true'">
		<Compile Remove="WinoAccountApiClient.cs" />
		<Compile Remove="WinoAccountDataSyncService.cs" />
		<Compile Remove="WinoAccountProfileService.cs" />
		<Compile Remove="WinoAccountIntelligenceSnapshotService.cs" />
		<Compile Remove="WinoIntelligenceCoordinator.cs" />
		<Compile Remove="WinoIntelligenceEntitlementService.cs" />
		<Compile Remove="CloudIntelligenceBackend.cs" />
		<Compile Remove="EmbeddedIntelligencePublicKeyProvider.cs" />
		<Compile Remove="IntelligenceCoverageHandoff.cs" />
		<Compile Remove="IntelligenceMessageContextResolver.cs" />
		<Compile Remove="IntelligenceSearchEligibilityService.cs" />
		<Compile Remove="IntelligenceSearchService.cs" />
		<Compile Remove="LocalIntelligenceJsonContext.cs" />
		<Compile Remove="LocalIntelligenceSearchEngine.cs" />
		<Compile Remove="LocalIntelligenceService.cs" />
		<Compile Remove="LocalIntelligenceStore.cs" />
		<Compile Remove="LocalizedAiRequests.cs" />
	</ItemGroup>
</Project>
